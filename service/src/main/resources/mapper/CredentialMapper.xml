<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seekwd.dormcheck.mapper.CredentialMapper">
  <resultMap id="credential" type="CredentialEntity">
    <id property="userId" column="user_id"/>
    <result property="ciphertext" column="ciphertext" typeHandler="com.seekwd.dormcheck.config.SqliteBytesTypeHandler"/>
    <result property="accountHint" column="account_hint"/>
    <result property="verifiedAt" column="verified_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>
  <select id="findSummary" resultMap="credential">
    SELECT user_id,account_hint,verified_at,updated_at FROM credentials WHERE user_id=#{userId}
  </select>
  <select id="findEncrypted" resultMap="credential">
    SELECT user_id,ciphertext,account_hint,verified_at,updated_at FROM credentials WHERE user_id=#{userId}
  </select>
  <select id="findVerifiedAt" resultType="string">SELECT verified_at FROM credentials WHERE user_id=#{userId}</select>
  <insert id="upsert">
    INSERT INTO credentials(user_id,ciphertext,account_hint,verified_at,updated_at)
    VALUES(#{userId},#{ciphertext},#{accountHint},NULL,#{updatedAt})
    ON CONFLICT(user_id) DO UPDATE SET ciphertext=excluded.ciphertext,account_hint=excluded.account_hint,
      verified_at=NULL,updated_at=excluded.updated_at
  </insert>
  <update id="updateVerification">
    UPDATE credentials SET verified_at=#{verifiedAt},updated_at=#{updatedAt} WHERE user_id=#{userId}
  </update>
  <delete id="delete">DELETE FROM credentials WHERE user_id=#{userId}</delete>
</mapper>
